#!/usr/bin/env bash
set -euo pipefail
unset SWIFT_DEBUG_INFORMATION_FORMAT SWIFT_DEBUG_INFORMATION_VERSION
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CACHE="$ROOT/.build/native-tools"
mkdir -p "$CACHE"
fetch() {
  local name="$1" url="$2" checksum="$3"
  if [[ ! -f "$CACHE/$name" ]] || [[ "$(shasum -a 256 "$CACHE/$name" | awk '{print $1}')" != "$checksum" ]]; then
    curl --fail --location --retry 2 --silent --show-error "$url" -o "$CACHE/$name.download"
    [[ "$(shasum -a 256 "$CACHE/$name.download" | awk '{print $1}')" == "$checksum" ]] || { echo "Checksum failed: $name" >&2; exit 1; }
    mv "$CACHE/$name.download" "$CACHE/$name"
  fi
}
prepare() {
  fetch duckdb-1.5.5.zip https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-osx-universal.zip 7b5b8915cc382d0708636fe6385c0cdad5a61c9ff8ba2638b3e2141640783155
  if [[ ! -f "$CACHE/prepared-1.5.5" ]]; then
    unzip -qo "$CACHE/duckdb-1.5.5.zip" -d "$CACHE/duckdb"
    touch "$CACHE/prepared-1.5.5"
  fi
}
case "${1:-prepare}" in
  prepare) prepare ;;
  embed)
    prepare
    APP="${2:?App bundle path required}"
    [[ -d "$APP/Contents/MacOS" ]] || exit 1
    SIGN="${EXPANDED_CODE_SIGN_IDENTITY:-}"
    if [[ -z "$SIGN" ]]; then
      signature=$(codesign --display --verbose=2 "$APP" 2>&1)
      if [[ "$signature" == *"Signature=adhoc"* ]]; then
        SIGN=-
      else
        SIGN_DIR=$(mktemp -d)
        trap 'rm -rf "$SIGN_DIR"' EXIT
        codesign --display --extract-certificates="$SIGN_DIR/cert" "$APP" >/dev/null
        [[ -s "$SIGN_DIR/cert0" ]] || { echo "Could not determine the app signing identity" >&2; exit 1; }
        SIGN=$(shasum -a 1 "$SIGN_DIR/cert0" | awk '{print $1}')
      fi
    fi
    mkdir -p "$APP/Contents/Frameworks"
    rm -f "$APP/Contents/MacOS/ty"
    lipo "$CACHE/duckdb/libduckdb.dylib" -thin arm64 -output "$APP/Contents/Frameworks/libduckdb.dylib"
    TIMESTAMP=--timestamp=none
    if [[ "$SIGN" != "-" && ( "${CONFIGURATION:-}" == "Release" || "${ACTION:-}" == "install" ) ]]; then
      TIMESTAMP=--timestamp
    fi
    codesign --force --sign "$SIGN" --options runtime "$TIMESTAMP" "$APP/Contents/Frameworks/libduckdb.dylib"
    codesign --force --sign "$SIGN" "$TIMESTAMP" --preserve-metadata=identifier,entitlements,flags "$APP"
    "$0" verify "$APP"
    ;;
  verify)
    APP="${2:?App bundle path required}"
    [[ -f "$APP/Contents/Frameworks/libduckdb.dylib" ]] || { echo "Bundled DuckDB missing" >&2; exit 1; }
    [[ ! -e "$APP/Contents/MacOS/ty" ]] || { echo "Removed analyzer is still bundled" >&2; exit 1; }
    for binary in "$APP/Contents/Frameworks/libduckdb.dylib"; do
      for architecture in $(lipo -archs "$binary"); do
        signature=$(codesign --display --verbose=2 --arch "$architecture" "$binary" 2>&1)
        [[ "$signature" == *"runtime)"* || "$signature" == *"runtime,"* ]] || {
          echo "Hardened runtime missing: $binary ($architecture)" >&2
          exit 1
        }
      done
    done
    codesign --verify --deep --strict --all-architectures "$APP"
    ;;
  *) exit 2 ;;
esac
