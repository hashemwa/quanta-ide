[
  {
    "label": "Run (Debug)",
    "command": "./scripts/quanta",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
    "allow_concurrent_runs": false
  },
  {
    "label": "Run (Release)",
    "command": "./scripts/quanta",
    "args": ["release"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
    "allow_concurrent_runs": false
  },
  {
    "label": "Test",
    "command": "./scripts/quanta",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "reveal_target": "center",
    "allow_concurrent_runs": false
  },
  {
    "label": "Logs",
    "command": "./scripts/quanta",
    "args": ["logs"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "reveal_target": "center",
